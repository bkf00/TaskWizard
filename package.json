{
  "name": "taskuri-ai-teams-emailuri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @taskuri-ai/web",
    "build": "npm run build --workspace @taskuri-ai/web",
    "start": "npm run start --workspace @taskuri-ai/web",
    "dev:local": "node tools/local-mvp-server.mjs",
    "test": "node tools/test-local-mvp.mjs",
    "test:local": "node tools/test-local-mvp.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint --workspace @taskuri-ai/web"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.36.4",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
