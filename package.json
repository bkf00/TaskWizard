{
  "name": "taskuri-ai-teams-emailuri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @taskuri-ai/web",
    "build": "npm run build --workspace @taskuri-ai/web",
    "start": "npm run start --workspace @taskuri-ai/web",
    "dev:local": "node tools/local-mvp-server.mjs",
    "test": "node tools/test-local-mvp.mjs",
    "test:api-imports": "tsx --test tools/test-api-import-route.ts",
    "test:domain": "tsx --test tools/test-domain-units.ts",
    "test:graph": "tsx --test tools/test-graph-units.ts",
    "test:imports": "tsx --test tools/test-import-fixtures.ts",
    "test:packages": "npm run test:domain && npm run test:graph && npm run test:imports && npm run test:api-imports",
    "test:local": "node tools/test-local-mvp.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mjs --max-warnings=0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.25",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.18",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0"
  }
}
