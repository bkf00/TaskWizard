# Local actor used by the MVP and manual admin endpoints
LOCAL_ACTOR_EMAIL=approver@firma.ro

# Local-only privacy rules file. Keep the real file ignored by Git.
TASKWIZARD_PRIVACY_RULES_FILE=config/privacy-rules.local.json

# Microsoft Entra ID / Graph application credentials
ENTRA_ID_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ID_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_ID_CLIENT_SECRET=replace-with-local-secret

# Optional aliases supported by the Graph package
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# NextAuth / Entra sign-in
AUTH_SECRET=replace-with-random-secret
NEXTAUTH_URL=http://localhost:3000

# Dedicated Outlook source folder
OUTLOOK_USER_ID=automation-mailbox@firma.ro
OUTLOOK_FOLDER_ID=mail-folder-id

# Microsoft Graph webhook/subscription settings
GRAPH_WEBHOOK_NOTIFICATION_URL=https://your-public-host.example.com/api/graph/webhook
GRAPH_LIFECYCLE_NOTIFICATION_URL=https://your-public-host.example.com/api/graph/webhook
GRAPH_WEBHOOK_CLIENT_STATE=replace-with-long-random-secret

# Planner test plan target
PLANNER_PLAN_ID=planner-plan-id
PLANNER_BUCKET_ID=planner-bucket-id
